PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/campus-mitra
JWT_SECRET=replace-with-a-strong-secret
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
CLIENT_URL=http://localhost:5173
# Comma-separated extra origins (Expo web, LAN dev). Native apps omit Origin; browsers need this for Expo.
ADDITIONAL_CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
SERVE_CLIENT=false

# Email Service (Gmail SMTP)
EMAIL_USER=your-email@example.com
EMAIL_PASS=your-email-app-password-without-spaces
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false

# Security
COOKIE_SAME_SITE=strict
COOKIE_SECURE=false
CSRF_SECRET=replace-with-strong-csrf-secret
CSRF_ENABLED=true

# Debug (Development only)
OTP_DEBUG=false

# Admin
ADMIN_EMAIL=admin@example.com

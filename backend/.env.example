PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/campus-mitra
JWT_SECRET=replace-with-a-strong-secret
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
CLIENT_URL=https://campusmitra-eight.vercel.app
# Comma-separated extra origins (Expo web, LAN dev). Native apps omit Origin; browsers need this for Expo.
ADDITIONAL_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8081,http://127.0.0.1:8081,https://campusmitra-eight.vercel.app
SERVE_CLIENT=false

# Email Service (Gmail SMTP)
EMAIL_PROVIDER=smtp
EMAIL_USER=your-email@example.com
EMAIL_FROM=your-email@example.com
EMAIL_FROM_NAME=CampusMitra
EMAIL_PASS=your-email-app-password-without-spaces
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
# Recommended on Render free because outbound SMTP ports can time out.
# EMAIL_PROVIDER=brevo
# BREVO_API_KEY=your-brevo-api-key

# Security
COOKIE_SAME_SITE=strict
COOKIE_SECURE=false
CSRF_SECRET=replace-with-strong-csrf-secret
CSRF_ENABLED=true

# Debug (Development only)
OTP_DEBUG=false

# Admin
ADMIN_EMAIL=admin@example.com
